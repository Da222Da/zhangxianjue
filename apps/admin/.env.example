# 本地开发自动登录示例：复制为 .env 后填写真实值
# ⚠️ .env 已被 .gitignore 忽略，请勿提交
# ⚠️ 仅在 npm run dev（import.meta.env.DEV）时生效；不要用于生产构建
# 账号密码留空时，会回退到 server/.env 的 DEV_LOGIN_*（需要 DEV_LOGIN_ENABLED=true）
# 改为 true（或直接填好下面两项）即可启用
VITE_DEV_AUTO_LOGIN=false
VITE_DEV_AUTO_LOGIN_PHONE=
# VITE_DEV_AUTO_LOGIN_USERNAME=
VITE_DEV_AUTO_LOGIN_PASSWORD=
