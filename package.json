  "main": "index.js",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,admin,client -c green,magenta,cyan \"npm:dev:server\" \"npm:dev:admin\" \"npm:dev:client\"",
    "dev:client": "npm run dev -w client",
    "dev:admin": "npm run dev -w admin",
    "dev:server": "npm run dev -w server",
    "dev:markdown": "npm run dev -w @zhangxianjue/markdown",
    "build:markdown": "npm run build -w @zhangxianjue/markdown",
    "test:markdown": "npm run test -w @zhangxianjue/markdown",
    "dev:markmap": "npm run dev -w @zhangxianjue/markmap",
    "build:markmap": "npm run build -w @zhangxianjue/markmap",
    "test:markmap": "npm run test -w @zhangxianjue/markmap"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Da222Da/zhangxianjue.git"
  },
  "keywords": [],
  "author": "",
