  },
  "homepage": "https://github.com/Da222Da/js-markdown-editor#readme",
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
