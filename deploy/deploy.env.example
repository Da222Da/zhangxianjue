# 一键部署配置：复制为 deploy/deploy.env 后填写（deploy.env 已被 gitignore）
# 含特殊字符的值请用单引号包起来，例如 ADMIN_PASSWORD='a$b#c'

# ===== 代码与运行目录 =====
# 脚本会自动识别仓库根目录；通常无需填写
# DEPLOY_DIR=/www/wwwroot/zhangxianjue

# ===== 域名 =====
CLIENT_DOMAIN=zhangxianjue.com
ADMIN_DOMAIN=admin.zhangxianjue.com

# ===== 服务端 =====
SERVER_PORT=3000
PM2_NAME=zhangxianjue-api
# 上传目录；留空默认 <仓库>/server/uploads
UPLOAD_DIR=

# ===== MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zhangxianjue_database
DB_USER=zhangxianjue
# 留空会自动生成并写回本文件
DB_PASSWORD=
# 仅首次建库时需要；留空时脚本会尝试读取宝塔本机配置并验证
DB_ROOT_USER=root
DB_ROOT_PASSWORD=

# ===== 首次部署自动创建管理员 =====
# 全部留空：脚本会自动创建 admin + 随机密码，并写入本文件的 ADMIN_PASSWORD
# 想用自己的账号时再填
ADMIN_USERNAME=
ADMIN_PHONE=
ADMIN_PASSWORD=

# ===== 从本地导入已有数据（可选） =====
# 把本地 mysqldump 生成的 .sql 上传到服务器后填绝对路径；
# 只在目标数据库为空时导入，不会覆盖线上数据。
IMPORT_SQL=
# 本地 server/uploads 目录上传后的绝对路径；会复制到 UPLOAD_DIR
IMPORT_UPLOADS=

# ===== 其他 =====
# 留空自动生成并写回本文件
JWT_SECRET=
# 1 = 强制覆盖 Nginx 配置（覆盖前会备份；会移除已配置的 SSL）
FORCE_NGINX=0
# 1 = 跳过 npm ci（依赖已安装时）
SKIP_INSTALL=0

# 可选：宝塔安装的 Node 不在默认 PATH 时手动指定
# NODE_BIN=/www/server/nodejs/v22.20.0/bin/node
# NPM_BIN=/www/server/nodejs/v22.20.0/bin/npm
# PM2_BIN=/www/server/nodejs/v22.20.0/bin/pm2
# NGINX_BIN=/www/server/nginx/sbin/nginx
# MYSQL_BIN=/www/server/mysql/bin/mysql
