{
  "name": "@zhangxianjue/markmap",
  "version": "0.1.0",
  "description": "手绘风格的 Markdown 思维导图 Vue 3 组件（rough.js + d3）",
  "type": "module",
  "main": "./dist/markmap.cjs",
  "module": "./dist/markmap.es.js",
  "types": "./types/index.d.ts",
  "files": [
    "dist",
    "types",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/markmap.es.js",
      "require": "./dist/markmap.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:e2e:shot": "node tests/e2e/run.mjs --screenshot",
    "prepublishOnly": "npm run test && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "d3-flextree": "^2.1.2",
    "d3-hierarchy": "^3.1.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "markdown-it": "^15.0.2",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@types/d3-flextree": "^2.1.4",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.4",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "keywords": [
    "vue3",
    "markmap",
    "markdown",
    "mindmap",
    "roughjs",
    "hand-drawn",
    "sketch"
  ],
  "author": "",
  "license": "ISC"
}
