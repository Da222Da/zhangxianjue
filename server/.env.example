# 服务端环境变量示例：复制为 .env 后按需修改（cp .env.example .env）
# .env 已被 .gitignore 忽略，请勿提交到版本库

# JWT 签名密钥，必填。未配置时登录接口会在 jwt.sign 处抛错。
# 生产环境请替换为强随机值：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-strong-random-secret

# 服务监听端口，缺省 3000
PORT=3000

# 运行环境 development / test / production，决定 src/config/config.json 读取哪一组数据库配置
NODE_ENV=development

# 图片上传目录。相对路径以 server 目录（process.cwd()）为基准解析，缺省 uploads
UPLOAD_DIR=uploads

# 单张图片大小上限（MB），缺省 5
UPLOAD_MAX_SIZE_MB=5

# Access Token 有效期，缺省 1h。格式为数字 + s/m/h/d，填写非该格式的值会告警并回退默认值
JWT_EXPIRES_IN=1h

# Refresh Token 有效期，缺省 7d。到期后需重新登录（服务端无令牌吊销机制）
JWT_REFRESH_EXPIRES_IN=7d
