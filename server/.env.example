# 服务端环境变量示例：复制为 .env 后按需修改（cp .env.example .env）
# .env 已被 .gitignore 忽略，请勿提交到版本库

# JWT 签名密钥，必填。未配置时登录接口会在 jwt.sign 处抛错。
# 生产环境请替换为强随机值：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-strong-random-secret

# 服务监听端口，缺省 3000
PORT=3000

# 运行环境 development / test / production，决定 src/config/config.json 读取哪一组数据库配置
NODE_ENV=development

# 生产数据库连接。设置了 DB_NAME 时会覆盖 config.json 对应环境的连接信息；
# 本地开发可全部留空，继续使用 config.json 的 development 段。
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# 图片上传目录。相对路径以 server 目录（process.cwd()）为基准解析，缺省 uploads
UPLOAD_DIR=uploads

# 单张图片大小上限（MB），缺省 5
UPLOAD_MAX_SIZE_MB=5

# Access Token 有效期，缺省 1h。格式为数字 + s/m/h/d，填写非该格式的值会告警并回退默认值
JWT_EXPIRES_IN=1h

# Refresh Token 有效期，缺省 7d。到期后需重新登录（服务端无令牌吊销机制）
JWT_REFRESH_EXPIRES_IN=7d

# 本地开发自动登录接口（POST /api/auth/dev/login），默认关闭。
# 只有 NODE_ENV !== production 且这里为 true 时才会挂载，且只接受本机回环地址。
# 两个前端的 .env 只需设置 VITE_DEV_AUTO_LOGIN=true；账号密码放在下面，避免进入前端产物。
# 千万不要在生产环境开启。
DEV_LOGIN_ENABLED=false

# 开发自动登录使用的账号：手机号与用户名二选一，手机号优先
# 这是可提交的示例文件，不要填真实密码；真实值写在 server/.env（已被 gitignore）
DEV_LOGIN_PHONE=
# DEV_LOGIN_USERNAME=
DEV_LOGIN_PASSWORD=
